{$SERVER_NAME} {
	encode gzip

	# API and WebSocket proxy — matched and handled first, before any rewrite
	handle /api/* {
		reverse_proxy server:3000
	}

	handle /ws {
		reverse_proxy server:3000
	}

	# Everything else: serve the Vue SPA with HTML5 history fallback
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
